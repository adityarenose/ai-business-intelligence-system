# Database configuration
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/ai_bi_system
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_bi_system
DB_USER=username
DB_PASSWORD=password

# Optional LLM configuration. Leave LLM_PROVIDER=none for the grounded
# deterministic assistant, or use a compatible provider endpoint.
LLM_PROVIDER=none
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://your-provider.example/v1/chat/completions

# Application settings
APP_ENV=development
APP_DEBUG=True
